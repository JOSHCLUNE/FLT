  "parentName": "Dickson.exists_unique_normalizedLift",
  "oldText":
  "have hz_11 : z.val 1 1 = z.val 0 0 := by\n      calc z.val 1 1 = (z.val 0 1 + z.val 1 1) - z.val 0 1 := by ring\n      _ = (z.val 0 0 + z.val 0 1) - z.val 0 1 := by rw [← eq1_01]\n      _ = z.val 0 0 := by ring",
