  "have h_inv_sum : (1 : ℚ) / n + 1 / 2 = 1 / d 0 + 1 / (2 * (d 1 : ℚ)) := by\n      calc (1 : ℚ) / n + 1 / 2 = (1 - (1 - 1 / (n : ℚ))) + 1 / 2 := by ring\n        _ = (1 - ((1 : ℚ) - 1 / d 0 + 1 / 2 * (1 - 1 / d 1))) + 1 / 2 := by rw [hsum']\n        _ = 1 / d 0 + 1 / (2 * (d 1 : ℚ)) := by ring",
