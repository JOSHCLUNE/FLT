  "oldText":
  "calc g''.val = (g'' * 1).val := by rw [mul_one]\n    _ = (g'' * (g'⁻¹ * g')).val := by rw [inv_mul_cancel]\n    _ = ((g'' * g'⁻¹) * g').val := by rw [mul_assoc]\n    _ = z.val * g'.val := Units.val_mul z g'\n    _ = (c • 1) * g'.val := by rw [hz_val]\n    _ = c • g'.val := by rw [Matrix.smul_mul, Matrix.one_mul]",
