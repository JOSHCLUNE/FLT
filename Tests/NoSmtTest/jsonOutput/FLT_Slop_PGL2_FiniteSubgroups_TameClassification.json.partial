  "shortenedStepsCount": 1,
  "parentName": "Dickson.pairStabilizer_isCyclic",
  "oldText":
  "change (QuotientGroup.mk (f g₁) : PGLOf (K p)) * (QuotientGroup.mk (f g₂) : PGLOf (K p)) = (g₁ : PGLOf (K p)) *\n        (g₂ : PGLOf (K p))",
  "message":
  "Try this:\n\n  [apply]   simp_all only [ne_eq, Subtype.forall, SetLike.coe_eq_coe, QuotientGroup.mk_mul, Subgroup.coe_mul]",
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
 {"tacticSucceeded": false,
  "startLine": 331,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.pairStabilizer_isCyclic",
  "oldText":
  "have h_norm : ∀ g : pairStabilizer p G x y, ∃ g' : GL (Fin 2) (K p),\n      (QuotientGroup.mk g' : PGLOf (K p)) = (g : PGLOf (K p)) ∧ g'.val.mulVec y.rep = y.rep ∧\n      ∀ g'',\n          (QuotientGroup.mk g'' : PGLOf (K p)) = (g : PGLOf (K p)) → g''.val.mulVec y.rep = y.rep → g'' = g' :=\n            by\n    intro g\n    obtain ⟨g', ⟨h1, h2⟩, h3⟩ := exists_unique_normalizedLift p (g : PGLOf (K p)) y g.2.2\n    exact ⟨g', h1, h2, fun g'' h1' h2' ↦ h3 g'' ⟨h1', h2'⟩⟩",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
