 {"tacticSucceeded": false,
  "startLine": 366,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.pairStabilizer_isCyclic",
  "oldText":
  "have hc_mul : ∀ g₁ g₂ : pairStabilizer p G x y, c (g₁ * g₂) = c g₁ * c g₂ := by\n    intro g₁ g₂\n\n    have h : (c (g₁ * g₂) - c g₁ * c g₂) • x.rep = 0 := by\n      rw [sub_smul, sub_eq_zero, ← hc_x, hf_mul, Units.val_mul, ← Matrix.mulVec_mulVec,\n      hc_x, Matrix.mulVec_smul, hc_x, ← mul_smul, mul_comm]\n    exact sub_eq_zero.mp (Or.resolve_right (smul_eq_zero.mp h) x.rep_nonzero)",
