  "oldText":
  "have h0 : HasSum (fun p : ℤ × ℤ ↦ (((p.1 : ℂ) * τ + p.2) ^ k)⁻¹)\n      ((periodPair τ hτ.ne').G k) := by\n    refine hasSum_lattice_prod hτ.ne' (f := fun w ↦ (w ^ k)⁻¹) ?_\n    have h := (periodPair τ hτ.ne').hasSum_sumInvPow 0 hk\n    rw [PeriodPair.sumInvPow_zero] at h\n    simpa using h",
