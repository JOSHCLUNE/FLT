  "oldText":
  "have hrowsHS : ∀ n : ℤ, HasSum (fun m : ℤ ↦ (((n : ℂ) * τ + m) ^ k)⁻¹)\n      (C * ∑' d : ℕ, (d : ℂ) ^ j * (e τ ^ n.natAbs) ^ d + (if n = 0 then Z else 0)) := by\n    intro n\n    have h := (summable_int_inv_pow ((n : ℂ) * τ) hk.le).hasSum\n    rwa [hrowval n] at h",
