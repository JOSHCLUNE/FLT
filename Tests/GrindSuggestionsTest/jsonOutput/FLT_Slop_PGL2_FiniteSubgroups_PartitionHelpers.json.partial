  "shortenedStepsCount": 0,
  "parentName": "Dickson.normalizer_complement_divides_main",
  "oldText":
  "rw [Nat.card_congr (MulAction.orbitEquivQuotientStabilizer _ h), h_quot,\n        Nat.mul_div_cancel _ Nat.card_pos]",
