 {"tacticSucceeded": false,
  "startLine": 566,
  "startCol": 4,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.sylow_fixedPoint_injective",
  "oldText":
  "exact commute_of_orderOf_prime_common_fixedPoint p (g : PGLOf (K p)) (h : PGLOf (K p)) (sylowFixedPoint p G hG_p P)\n      (sylow_element_order_p p G P g hg hg1) (sylow_element_order_p p G Q h hh hh1)\n      (sylow_element_fixes p G hG_p P g hg) (hPQ.symm ▸ sylow_element_fixes p G hG_p Q h hh)",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PartitionHelpers.lean"},
 {"tacticSucceeded": false,
  "startLine": 570,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.sylow_fixedPoint_injective",
  "oldText":
  "have h_pq : ∀ g ∈ (P : Subgroup G) ⊔ (Q : Subgroup G), ∃ a ∈ (P : Subgroup G), ∃ b ∈ (Q : Subgroup G), g = a * b := by\n    intro g hg\n    rw [Subgroup.sup_eq_closure] at hg\n    induction hg using Subgroup.closure_induction\n    next x hx =>\n      cases hx with\n      | inl hx => exact ⟨x, hx, 1, Q.one_mem, (mul_one x).symm⟩\n      | inr hx => exact ⟨1, P.one_mem, x, hx, (one_mul x).symm⟩\n    next => exact ⟨1, P.one_mem, 1, Q.one_mem, (mul_one 1).symm⟩\n    next x y hx hy =>\n      obtain ⟨a, ha, b, hb, rfl⟩ := hx\n      obtain ⟨c, hc, d, hd, rfl⟩ := hy\n      exact ⟨a * c, P.mul_mem ha hc, b * d, Q.mul_mem hb hd, by\n        rw [← mul_assoc, mul_assoc a b c, (h_comm_G c hc b hb).symm, ← mul_assoc a c b, mul_assoc]⟩\n    next x hx =>\n      obtain ⟨a, ha, b, hb, rfl⟩ := hx\n      exact ⟨a⁻¹, P.inv_mem ha, b⁻¹, Q.inv_mem hb, by\n        rw [mul_inv_rev, ← h_comm_G a⁻¹ (P.inv_mem ha) b⁻¹ (Q.inv_mem hb)]⟩",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PartitionHelpers.lean"},
 {"tacticSucceeded": false,
