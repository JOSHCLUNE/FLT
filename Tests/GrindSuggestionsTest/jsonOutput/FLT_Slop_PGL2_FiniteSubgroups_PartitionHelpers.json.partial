  "oldText":
  "have h_d : d = (c : K p) * d := by\n    have h4 := congr_fun (congr_fun h_mul 1) 1\n    simp only [Matrix.smul_apply, Matrix.mul_apply, Fin.sum_univ_two, A, B] at h4\n    change 0 * β + d * 1 = (c : K p) * (0 * b + 1 * d) at h4\n    calc d = 0 * β + d * 1 := by ring\n      _ = (c : K p) * (0 * b + 1 * d) := h4\n      _ = (c : K p) * d := by ring",
