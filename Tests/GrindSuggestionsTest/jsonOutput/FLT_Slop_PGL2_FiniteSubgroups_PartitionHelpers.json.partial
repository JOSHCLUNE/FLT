 {"tacticSucceeded": false,
  "startLine": 166,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.sylow_pairwise_trivial_intersection",
  "oldText":
  "let S : Subgroup G := {\n    carrier := {x | ∃ a ∈ P, ∃ b ∈ Q, x = a * b}\n    mul_mem' := by\n      rintro _ _ ⟨yP, hyP, yQ, hyQ, rfl⟩ ⟨zP, hzP, zQ, hzQ, rfl⟩\n      refine ⟨yP * zP, P.mul_mem hyP hzP, yQ * zQ, Q.mul_mem hyQ hzQ, ?_⟩\n      rw [mul_assoc, ← mul_assoc yQ, ← h_comm_G zP hzP yQ hyQ, mul_assoc zP, ← mul_assoc yP]\n    one_mem' := ⟨1, P.one_mem, 1, Q.one_mem, (mul_one 1).symm⟩\n    inv_mem' := by\n      rintro _ ⟨yP, hyP, yQ, hyQ, rfl⟩\n      refine ⟨yP⁻¹, P.inv_mem hyP, yQ⁻¹, Q.inv_mem hyQ, ?_⟩\n      rw [mul_inv_rev, ← h_comm_G yP⁻¹ (P.inv_mem hyP) yQ⁻¹ (Q.inv_mem hyQ)]\n  }",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PartitionHelpers.lean"},
 {"tacticSucceeded": false,
