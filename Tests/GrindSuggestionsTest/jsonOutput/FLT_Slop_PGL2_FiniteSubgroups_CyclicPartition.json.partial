  "parentName": "Dickson.dihedral_of_hasCyclicPartition_odd",
  "oldText":
  "haveI hH0_Normal : H0.Normal := Subgroup.normalizer_eq_top_iff.mp\n    (Subgroup.eq_top_of_card_eq _ (hH0_norm.trans hN.symm))",
