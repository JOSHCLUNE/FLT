  "have hb_zpow_eq_toNat : ∀ (i : ℤ), b ^ i = b ^ (i % (n : ℤ)).toNat := by\n    intro i\n    calc b ^ i = b ^ (i % (n : ℤ)) := (hb_zpow_mod i).symm\n      _ = b ^ ((i % (n : ℤ)).toNat : ℤ) := by\n        rw [Int.toNat_of_nonneg (Int.emod_nonneg i (by omega))]\n      _ = b ^ (i % (n : ℤ)).toNat := by rw [zpow_natCast]",
