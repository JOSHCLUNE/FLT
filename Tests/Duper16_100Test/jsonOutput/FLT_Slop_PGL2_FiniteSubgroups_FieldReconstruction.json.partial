  "parentName": "Dickson.z1_eq_pm_minus_one",
  "oldText":
  "have h_norm_card : Nat.card (Subgroup.normalizer ((P : Subgroup G) : Set G)) = p ^ m * (p ^ m - 1) :=\n    Nat.eq_of_mul_eq_mul_left (Nat.succ_pos (p ^ m)) <| calc\n      (p ^ m + 1) * Nat.card (Subgroup.normalizer ((P : Subgroup G) : Set G))\n        = Nat.card G := by\n          rw [← n_p_eq_pgl p G m hm hG hn_p, ← Nat.card_eq_fintype_card, Nat.card_congr (Sylow.equivQuotientNormalizer P)]\n          exact (Subgroup.card_eq_card_quotient_mul_card_subgroup _).symm\n      _ = (p ^ m + 1) * (p ^ m * (p ^ m - 1)) := by\n          rw [hG, Nat.mul_comm 2 m, Nat.pow_mul, ← Nat.one_pow 2, Nat.sq_sub_sq (p ^ m) 1, ← Nat.mul_assoc, Nat.mul_comm (p ^ m) (p ^ m + 1), Nat.mul_assoc]",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/FieldReconstruction.lean"},
