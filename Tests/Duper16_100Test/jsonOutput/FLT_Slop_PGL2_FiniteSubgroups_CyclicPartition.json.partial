  "parentName": "Dickson.sylow_le_normal_of_coprime_index",
  "oldText":
  "exact nomatch ((Fact.out : Nat.Prime p).not_dvd_one ((hcop : Nat.gcd N.index p = 1) ▸\n      Nat.dvd_gcd (dvd_trans (dvd_pow_self p (Nat.succ_ne_zero n))\n        (hn ▸ Subgroup.card_subgroup_dvd_card (P.map (QuotientGroup.mk' N)))) (dvd_refl p)))",
