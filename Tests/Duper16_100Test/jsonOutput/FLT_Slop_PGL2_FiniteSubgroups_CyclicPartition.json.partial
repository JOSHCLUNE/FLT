  "shortenedStepsCount": 0,
  "parentName": "Dickson.card_elements_orderOf_prime",
  "oldText":
  "let f : (Σ P : Sylow p G, {x : G // x ∈ (P : Subgroup G) ∧ x ≠ 1}) → {x : G | orderOf x = p} :=\n    fun ⟨P, x, hxP, hx1⟩ ↦ ⟨x, by\n      have h_le := Subgroup.card_dvd_of_le (Subgroup.zpowers_le.mpr hxP)\n      rw [h_card P, Nat.card_eq_fintype_card, Fintype.card_zpowers] at h_le\n      cases Nat.dvd_prime hp.out |>.mp h_le with\n      | inl h => exact absurd (orderOf_eq_one_iff.mp h) hx1\n      | inr h => exact h⟩",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/CyclicPartition.lean"},
 {"tacticSucceeded": false,
