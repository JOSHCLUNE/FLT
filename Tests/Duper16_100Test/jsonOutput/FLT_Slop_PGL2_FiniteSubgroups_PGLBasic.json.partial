  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
  "startLine": 129,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.pgl_mulEquiv_psl",
  "oldText":
  "have h_inj : Function.Injective f := fun x y ↦ by\n    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x\n    obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective y\n    intro h\n    change QuotientGroup.mk (Matrix.SpecialLinearGroup.toGL a) = QuotientGroup.mk (Matrix.SpecialLinearGroup.toGL b) at h\n    rw [QuotientGroup.eq, Subgroup.mem_center_iff] at h ⊢\n    exact fun g ↦ Subtype.ext <| congr_arg Units.val (h (Matrix.SpecialLinearGroup.toGL g))",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
