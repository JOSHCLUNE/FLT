  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have h_diag_det_ne_zero : (Matrix.diagonal ![lambda1, lambda2]).det ≠ 0 := by\n    intro hz\n    have hd1 : (Matrix.diagonal ![lambda1, lambda2]).det = lambda1 * lambda2 := by\n      rw [Matrix.det_fin_two]\n      change (Matrix.diagonal ![lambda1, lambda2] 0 0) * (Matrix.diagonal ![lambda1, lambda2] 1 1) - (Matrix.diagonal ![lambda1, lambda2] 0 1) * (Matrix.diagonal ![lambda1, lambda2] 1 0) = lambda1 * lambda2\n      change lambda1 * lambda2 - 0 * 0 = lambda1 * lambda2\n      ring\n    rw [hd1] at hz\n    rw [hlambda2.2] at hz\n    exact g.isUnit.map Matrix.detMonoidHom |>.ne_zero hz",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
