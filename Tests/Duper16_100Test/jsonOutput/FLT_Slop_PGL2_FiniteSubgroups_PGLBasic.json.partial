 {"tacticSucceeded": false,
  "startLine": 679,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "obtain ⟨v2, hv2_ne, hv2⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr <|\n    show (g.val - lambda2 • 1).det = 0 by\n      have hlambda2_eq_zero : lambda2^2 - g.val.trace * lambda2 + g.val.det = 0 := by\n        calc lambda2^2 - g.val.trace * lambda2 + g.val.det = (g.val.trace - lambda1)^2 - g.val.trace * (g.val.trace - lambda1) + g.val.det := rfl\n          _ = lambda1^2 - g.val.trace * lambda1 + g.val.det := by ring\n          _ = 0 := hlambda1\n      rw [expand lambda2, hlambda2_eq_zero]",
  "message": null,
