  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "rw [Matrix.mul_assoc, ← Units.val_mul, mul_inv_cancel P, Units.val_one, Matrix.mul_one]",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
  "startLine": 795,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have h_order_eq : orderOf (QuotientGroup.mk g : PGLOf (K p)) = orderOf (QuotientGroup.mk Y : PGLOf (K p)) := by\n    have h_semi : SemiconjBy (QuotientGroup.mk P : PGLOf (K p)) (QuotientGroup.mk Y : PGLOf (K p)) (QuotientGroup.mk g : PGLOf (K p)) := by\n      change (QuotientGroup.mk (P * Y) : PGLOf (K p)) = QuotientGroup.mk (g * P)\n      have h_eq : P * Y = g * P := by\n        calc P * Y = P * Y * 1 := by rw [mul_one]\n          _ = P * Y * (P⁻¹ * P) := by rw [inv_mul_cancel]\n          _ = (P * Y * P⁻¹) * P := by rw [← mul_assoc (P * Y)]\n          _ = g * P := by rw [← hP]\n      rw [h_eq]\n    exact h_semi.orderOf_eq.symm",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
  "startLine": 796,
  "startCol": 4,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have h_semi : SemiconjBy (QuotientGroup.mk P : PGLOf (K p)) (QuotientGroup.mk Y : PGLOf (K p)) (QuotientGroup.mk g : PGLOf (K p)) := by\n      change (QuotientGroup.mk (P * Y) : PGLOf (K p)) = QuotientGroup.mk (g * P)\n      have h_eq : P * Y = g * P := by\n        calc P * Y = P * Y * 1 := by rw [mul_one]\n          _ = P * Y * (P⁻¹ * P) := by rw [inv_mul_cancel]\n          _ = (P * Y * P⁻¹) * P := by rw [← mul_assoc (P * Y)]\n          _ = g * P := by rw [← hP]\n      rw [h_eq]",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
