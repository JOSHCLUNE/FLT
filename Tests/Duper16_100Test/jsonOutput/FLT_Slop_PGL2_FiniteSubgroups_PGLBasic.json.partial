  "parentName": "Dickson.pgl_mulEquiv_psl",
  "oldText":
  "have h_sqrt : ∀ x : K p, ∃ c : K p, c ^ 2 = x := fun x ↦\n    let ⟨y, hy⟩ := IsAlgClosed.exists_root (Polynomial.X ^ 2 - Polynomial.C x) (fun h ↦ by rw [Polynomial.degree_X_pow_sub_C (by norm_num)] at h; norm_num at h)\n    ⟨y, by rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hy; exact hy⟩",
  "message": null,
  "goalIsProp": true,
