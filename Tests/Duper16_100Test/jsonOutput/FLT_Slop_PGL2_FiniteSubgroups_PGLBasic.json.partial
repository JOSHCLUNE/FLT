  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have h_g : g.val * P.val * (P⁻¹).val = g.val := by rw [Matrix.mul_assoc, ← Units.val_mul, mul_inv_cancel P, Units.val_one, Matrix.mul_one]",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
  "startLine": 790,
