  "shortenedStepsCount": 0,
  "parentName": "Dickson.card_eigenvalues",
  "oldText":
  "have hxy : x = y ↔ (g.val.trace)^2 = 4 * g.val.det := by\n    change x = y ↔ T^2 = 4 * D\n    constructor <;> intro h\n    · apply sub_eq_zero.mp\n      change x = -x + T at h\n      calc T^2 - 4 * D = ((-x + T) - x)^2 - 4 * (x^2 - T * x + D) := by ring\n        _ = (x - x)^2 - 4 * 0 := by rw [hx, ← h]\n        _ = 0 := by ring\n    · change x = -x + T\n      have h_sq : (2 * x - T)^2 = 0 := by\n        calc (2 * x - T)^2 = 4 * (x^2 - T * x + D) + (T^2 - 4 * D) := by ring\n          _ = 4 * 0 + 0 := by rw [hx, sub_eq_zero.mpr h]\n          _ = 0 := by ring\n      calc x = x - (2 * x - T) := by rw [sq_eq_zero_iff.mp h_sq]; ring\n        _ = -x + T := by ring",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
