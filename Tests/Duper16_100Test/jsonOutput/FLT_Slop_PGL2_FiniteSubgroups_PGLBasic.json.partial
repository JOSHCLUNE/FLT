  "oldText":
  "rw [show {x : K p | (g.val - x • 1).det = 0} = {x | x^2 - T * x + D = 0} from Set.ext (fun z ↦ by change (g.val - z • 1).det = 0 ↔ z^2 - T * z + D = 0; rw [h_det z])]",
