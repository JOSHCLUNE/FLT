  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "let f : Polynomial (K p) := Polynomial.X^2 - Polynomial.C g.val.trace * Polynomial.X + Polynomial.C g.val.det",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
  "startLine": 640,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have h_deg : f.degree ≠ 0 := fun h ↦ by\n    have h1 : f.coeff 2 = 1 := by\n      change (Polynomial.X^2 - Polynomial.C g.val.trace * Polynomial.X + Polynomial.C g.val.det).coeff 2 = 1\n      simp only [Polynomial.coeff_add, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C_mul, Polynomial.coeff_X, Polynomial.coeff_C]\n      change (1 : K p) - g.val.trace * 0 + 0 = 1\n      ring\n    have h2 : f.coeff 2 = 0 := by rw [Polynomial.eq_C_of_degree_eq_zero h, Polynomial.coeff_C, if_neg (by norm_num : 2 ≠ 0)]\n    exact one_ne_zero (h1.symm.trans h2)",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
  "startLine": 641,
  "startCol": 4,
