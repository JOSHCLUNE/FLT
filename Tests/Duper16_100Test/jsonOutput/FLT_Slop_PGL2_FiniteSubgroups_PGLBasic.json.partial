 {"tacticSucceeded": false,
  "startLine": 898,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_eq_prime_of_discrim_zero",
  "oldText":
  "have h_two_ne : (2 : K p) ≠ 0 :=\n    (NeZero.of_not_dvd (R := K p) (fun h ↦ absurd (Nat.le_of_dvd (by norm_num) h) (not_le.mpr h_odd.out))).out",
