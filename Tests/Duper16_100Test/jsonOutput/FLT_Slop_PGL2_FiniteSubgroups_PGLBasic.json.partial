 {"tacticSucceeded": false,
  "startLine": 901,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_eq_prime_of_discrim_zero",
  "oldText":
  "have h_four_ne : (4 : K p) ≠ 0 := by\n    intro h4\n    have h22 : (2 * 2 : K p) = 0 := by\n      calc (2 * 2 : K p) = 4 := by ring\n        _ = 0 := h4\n    exact h_two_ne (mul_self_eq_zero.mp h22)",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
