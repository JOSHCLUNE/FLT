  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have h_ne : lambda1 ≠ lambda2 := fun h ↦ h_discr <| by\n    calc (g.val.trace)^2 = (2 * lambda1)^2 := by rw [← hlambda2.1, h]; ring\n      _ = 4 * g.val.det := by rw [← hlambda2.2, h]; ring",
  "message": null,
  "goalIsProp": true,
