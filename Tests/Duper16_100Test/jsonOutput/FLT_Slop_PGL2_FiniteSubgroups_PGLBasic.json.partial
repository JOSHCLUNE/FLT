  "startCol": 6,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have h_eq : P * Y = g * P := by\n        calc P * Y = P * Y * 1 := by rw [mul_one]\n          _ = P * Y * (P⁻¹ * P) := by rw [inv_mul_cancel]\n          _ = (P * Y * P⁻¹) * P := by rw [← mul_assoc (P * Y)]\n          _ = g * P := by rw [← hP]",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
