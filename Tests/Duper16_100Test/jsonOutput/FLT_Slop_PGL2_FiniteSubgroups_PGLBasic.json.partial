  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_eq_prime_of_discrim_zero",
  "oldText":
  "have h10 : g.val 1 0 = 0 := by\n      have h := congr_fun (congr_fun hE1 1) 1\n      change ∑ k : Fin 2, E1.val 1 k * g.val k 1 = ∑ k : Fin 2, g.val 1 k * E1.val k 1 at h\n      rw [Fin.sum_univ_two, Fin.sum_univ_two] at h\n      change 0 * g.val 0 1 + 1 * g.val 1 1 = g.val 1 0 * 1 + g.val 1 1 * 1 at h\n      simp only [zero_mul, zero_add, one_mul, mul_one] at h\n      calc g.val 1 0 = (g.val 1 0 + g.val 1 1) - g.val 1 1 := by ring\n        _ = g.val 1 1 - g.val 1 1 := by rw [← h]\n        _ = 0 := by ring",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
 {"tacticSucceeded": false,
