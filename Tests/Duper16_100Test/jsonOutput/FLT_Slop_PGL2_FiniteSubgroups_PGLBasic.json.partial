  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have expand (t : K p) : (g.val - t • 1).det = t^2 - g.val.trace * t + g.val.det := by\n    rw [Matrix.det_fin_two, Matrix.trace_fin_two, Matrix.det_fin_two]\n    change (g.val 0 0 - t * 1) * (g.val 1 1 - t * 1) - (g.val 0 1 - t * 0) * (g.val 1 0 - t * 0) = t^2 - (g.val 0 0 + g.val 1 1) * t + (g.val 0 0 * g.val 1 1 - g.val 0 1 * g.val 1 0)\n    ring",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PGLBasic.lean"},
