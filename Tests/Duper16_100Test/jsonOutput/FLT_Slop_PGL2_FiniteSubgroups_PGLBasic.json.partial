 {"tacticSucceeded": false,
  "startLine": 650,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orderOf_coprime_of_discrim_ne_zero",
  "oldText":
  "have hlambda1 : lambda1^2 - g.val.trace * lambda1 + g.val.det = 0 := by\n    have h_eval : f.eval lambda1 = lambda1^2 - g.val.trace * lambda1 + g.val.det := by\n      change (Polynomial.X^2 - Polynomial.C g.val.trace * Polynomial.X + Polynomial.C g.val.det).eval lambda1 = lambda1^2 - g.val.trace * lambda1 + g.val.det\n      simp only [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C]\n    rw [← h_eval]\n    exact h_root",
  "message": null,
