  "parentName": "Dickson.fixes_point_coprime_isCyclic",
  "oldText":
  "have hH'_fix : ∀ g : H', (g : PGLOf (K p)) • infinity p = infinity p := by\n    intro ⟨g, hg⟩\n    obtain ⟨h, hh, rfl⟩ := Subgroup.mem_map.mp hg\n    have heq : (c * h * c⁻¹ : PGLOf (K p)) • c • x = c • x := by\n      rw [← mul_smul, inv_mul_cancel_right, mul_smul, hH_fix ⟨h, hh⟩]\n    exact hc ▸ heq",
  "message": null,
  "goalIsProp": true,
