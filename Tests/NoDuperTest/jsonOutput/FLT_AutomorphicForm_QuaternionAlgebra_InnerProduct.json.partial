 {"tacticSucceeded": false,
  "startLine": 789,
  "startCol": 26,
  "shortenedStepsCount": 0,
  "parentName":
  "TotallyDefiniteQuaternionAlgebra.HeckeAlgebra.Pi.subalgebraEquiv",
