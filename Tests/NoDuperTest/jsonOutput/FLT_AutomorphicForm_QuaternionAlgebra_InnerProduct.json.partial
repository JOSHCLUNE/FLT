  "parentName":
  "TotallyDefiniteQuaternionAlgebra.HeckeAlgebra.Eigenform.exists",
  "oldText":
  "have : ∀ x ∈ HeckeAlgebra.anemic D 𝒮, ∃ a : ℂ, x • μ = a • μ := by\n    intro x hx\n    induction hx using Algebra.adjoin_induction with\n    | mem x hx => obtain ⟨v, hvS, hvQ, rfl⟩ := hx; exact ⟨φ _ _ _, hμ' _ _ _⟩\n    | algebraMap r => exact ⟨algebraMap _ _ r, by simp⟩\n    | add x y hx hy H₁ H₂ =>\n      obtain ⟨a₁, ha₁⟩ := H₁\n      obtain ⟨a₂, ha₂⟩ := H₂\n      exact ⟨a₁ + a₂, by simp [add_smul, ha₁, ha₂]⟩\n    | mul x y hx hy H₁ H₂ =>\n      obtain ⟨a₁, ha₁⟩ := H₁\n      obtain ⟨a₂, ha₂⟩ := H₂\n      exact ⟨a₂ * a₁, by rw [mul_smul, ha₂, smul_comm, ha₁, mul_smul]⟩",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/AutomorphicForm/QuaternionAlgebra/InnerProduct.lean"},
