 {"tacticSucceeded": false,
  "startLine": 345,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "SL2_center_card",
  "oldText":
  "have h_center : Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) F) = Subgroup.zpowers (-1 : Matrix.SpecialLinearGroup (Fin 2) F) := by\n    refine' le_antisymm _ _\n    · intro g hg\n      rw [Subgroup.mem_center_iff] at hg\n      have h1 : !![(1 : F), 1; 0, 1] * g.val = g.val * !![(1 : F), 1; 0, 1] :=\n        congr_arg Subtype.val (hg (SL2.E12 F 1))\n      have h2 : !![(1 : F), 0; 1, 1] * g.val = g.val * !![(1 : F), 0; 1, 1] :=\n        congr_arg Subtype.val (hg (SL2.E21 F 1))\n\n      have eq_10 : (g.val) 1 0 = 0 := by\n        have h := congr_fun (congr_fun h1 0) 0\n        simp only [Matrix.mul_apply, Fin.sum_univ_two] at h\n        change (1 : F) * g.val 0 0 + 1 * g.val 1 0 = g.val 0 0 * 1 + g.val 0 1 * 0 at h\n        simp only [mul_one, mul_zero, one_mul, add_zero] at h\n        exact add_left_cancel (h.trans (add_zero _).symm)\n\n      have eq_01 : (g.val) 0 1 = 0 := by\n        have h := congr_fun (congr_fun h2 0) 0\n        simp only [Matrix.mul_apply, Fin.sum_univ_two] at h\n        change (1 : F) * g.val 0 0 + 0 * g.val 1 0 = g.val 0 0 * 1 + g.val 0 1 * 1 at h\n        simp only [mul_one, zero_mul, one_mul, add_zero] at h\n        exact (add_left_cancel ((add_zero _).trans h)).symm\n\n      have eq_11 : (g.val) 1 1 = (g.val) 0 0 := by\n        have h := congr_fun (congr_fun h1 0) 1\n        simp only [Matrix.mul_apply, Fin.sum_univ_two] at h\n        change (1 : F) * g.val 0 1 + 1 * g.val 1 1 = g.val 0 0 * 1 + g.val 0 1 * 1 at h\n        simp only [eq_01, mul_one, mul_zero, one_mul, add_zero, zero_add] at h\n        exact h\n\n      have hc : g.val = (g.val 0 0) • (1 : Matrix (Fin 2) (Fin 2) F) := by\n        ext i j\n        match i, j with\n        | 0, 0 => change g.val 0 0 = g.val 0 0 * 1; exact (mul_one _).symm\n        | 0, 1 => change g.val 0 1 = g.val 0 0 * 0; exact eq_01.trans (mul_zero _).symm\n        | 1, 0 => change g.val 1 0 = g.val 0 0 * 0; exact eq_10.trans (mul_zero _).symm\n        | 1, 1 => change g.val 1 1 = g.val 0 0 * 1; exact eq_11.trans (mul_one _).symm\n\n      have h_det : (g.val 0 0) ^ 2 = 1 := by\n        have hd := g.2\n        change Matrix.det g.val = 1 at hd\n        rw [hc, Matrix.det_smul] at hd\n        change (g.val 0 0) ^ 2 * Matrix.det 1 = 1 at hd\n        rw [Matrix.det_one, mul_one] at hd\n        exact hd\n\n      rcases eq_or_eq_neg_of_sq_eq_sq _ _ (h_det.trans (one_pow 2).symm) with h | h\n      · have hg1 : g = 1 := Subtype.ext (by rw [hc, h, one_smul]; rfl)\n        rw [hg1]\n        exact Subgroup.one_mem _\n      · have hg_1 : g = -1 := Subtype.ext (by rw [hc, h, neg_smul, one_smul]; rfl)\n        rw [hg_1]\n        exact Subgroup.mem_zpowers _\n\n    · rw [Subgroup.zpowers_le, Subgroup.mem_center_iff]\n      intro m\n      apply Subtype.ext\n      change m.val * (-1 : Matrix (Fin 2) (Fin 2) F) = (-1 : Matrix (Fin 2) (Fin 2) F) * m.val\n      simp only [neg_mul, mul_neg, one_mul, mul_one]",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PSLBasic.lean"},
