  "oldText":
  "have h_center : Matrix.SpecialLinearGroup.toGL (SL2.E12 F a) ∈ Subgroup.center (GL (Fin 2) F) := by\n      rw [SL2ToPGL, MonoidHom.comp_apply] at h_eq_one\n      have h_ker : _ ∈ MonoidHom.ker _ := MonoidHom.mem_ker.mpr h_eq_one\n      rwa [QuotientGroup.ker_mk'] at h_ker",
