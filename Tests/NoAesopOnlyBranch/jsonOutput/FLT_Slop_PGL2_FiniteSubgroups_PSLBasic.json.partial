  "parentName": "SL2_card",
  "oldText":
  "rw [show (Fintype.card F ^ 2 - 1) * (Fintype.card F ^ 2 - Fintype.card F) = (Fintype.card F * (Fintype.card F ^ 2 - 1)) * (Fintype.card F - 1) from calc\n    _ = (Fintype.card F ^ 2 - 1) * (Fintype.card F * Fintype.card F - Fintype.card F * 1) := by rw [sq, mul_one]\n    _ = (Fintype.card F ^ 2 - 1) * (Fintype.card F * (Fintype.card F - 1)) := by rw [← Nat.mul_sub_left_distrib]\n    _ = (Fintype.card F ^ 2 - 1) * Fintype.card F * (Fintype.card F - 1) := by rw [← mul_assoc]\n    _ = Fintype.card F * (Fintype.card F ^ 2 - 1) * (Fintype.card F - 1) := by rw [mul_comm (Fintype.card F ^ 2 - 1) _]] at h_iso",
