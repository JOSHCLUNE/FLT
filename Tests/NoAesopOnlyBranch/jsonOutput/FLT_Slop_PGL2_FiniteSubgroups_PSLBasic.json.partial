  "shortenedStepsCount": 0,
  "parentName": "PGL.orderOf_E12_image",
  "oldText":
  "have h_exp : ∀ n : ℕ, (SL2.E12 F a) ^ n = SL2.E12 F (((n : ℕ) : F) * a) := by\n      intro n\n      induction n with\n      | zero =>\n        rw [pow_zero]\n        ext i j\n        change (1 : Matrix (Fin 2) (Fin 2) F) i j = !![1, ((0 : ℕ) : F) * a; 0, 1] i j\n        rw [Matrix.one_fin_two, Nat.cast_zero, zero_mul]\n      | succ n ih =>\n        rw [pow_succ, ih]\n        ext i j\n        change (!![1, ((n : ℕ) : F) * a; 0, 1] * !![1, a; 0, 1] : Matrix (Fin 2) (Fin 2) F) i j =\n               !![1, ((n + 1 : ℕ) : F) * a; 0, 1] i j\n        simp only [Matrix.mul_apply, Fin.sum_univ_two]\n        match i, j with\n        | 0, 0 => change (1 : F) * 1 + (((n : ℕ) : F) * a) * 0 = 1; ring\n        | 0, 1 => change (1 : F) * a + (((n : ℕ) : F) * a) * 1 = (((n + 1 : ℕ) : F) * a); rw [Nat.cast_add, Nat.cast_one]; ring\n        | 1, 0 => change (0 : F) * 1 + 1 * 0 = 0; ring\n        | 1, 1 => change (0 : F) * a + 1 * 1 = 1; ring",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PSLBasic.lean"},
 {"tacticSucceeded": false,
