  "Try this:\n\n  [apply]     subst ha\n    simp_all only [gt_iff_lt, ne_eq, Subgroup.coe_comap, Set.mem_preimage, map_one, SetLike.mem_coe, one_mem]",
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PSLBasic.lean"},
 {"tacticSucceeded": true,
