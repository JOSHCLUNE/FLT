  "shortenedStepsCount": 1,
  "parentName": "PSLImageInPGL_le_of_index_two",
  "oldText": "rw [h_order_p' b hb]",
  "message":
  "Try these:\n  [apply] grind only [FiniteField.card, Nat.Prime.odd_of_ne_two, #202f]\n  [apply] grind only [FiniteField.card, Nat.Prime.odd_of_ne_two]\n  [apply] grind =>\n    instantiate only [#202f, FiniteField.card, Nat.Prime.odd_of_ne_two]\n    done",
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PSLBasic.lean"},
