 {"tacticSucceeded": false,
  "startLine": 224,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "PSLImageInPGL_le_of_index_two",
  "oldText":
  "have h_order_p' : ∀ b : F, b ≠ 0 → orderOf (SL2ToPGL F (SL2.E21 F b)) = p := fun b hb ↦ by\n    refine' orderOf_eq_prime _ _\n    · have h_exp : ∀ n : ℕ, (SL2.E21 F b) ^ n = SL2.E21 F (n * b) := by\n        intro n; induction n with\n        | zero =>\n          ext i j; change (1 : Matrix (Fin 2) (Fin 2) F) i j = !![1, 0; ((0 : ℕ) : F) * b, 1] i j\n          rw [Matrix.one_fin_two, Nat.cast_zero, zero_mul]\n        | succ n ih =>\n          rw [pow_succ, ih]; ext i j\n          change (!![1, 0; ((n : ℕ) : F) * b, 1] * !![1, 0; b, 1] : Matrix (Fin 2) (Fin 2) F) i j =\n                 !![1, 0; ((n + 1 : ℕ) : F) * b, 1] i j\n          simp only [Matrix.mul_apply, Fin.sum_univ_two]\n          match i, j with\n          | 0, 0 => change (1 : F) * 1 + 0 * b = 1; ring\n          | 0, 1 => change (1 : F) * 0 + 0 * 1 = 0; ring\n          | 1, 0 => change (((n : ℕ) : F) * b) * 1 + 1 * b = (((n + 1 : ℕ) : F) * b); rw [Nat.cast_add, Nat.cast_one]; ring\n          | 1, 1 => change (((n : ℕ) : F) * b) * 0 + 1 * 1 = 1; ring\n      rw [← map_pow, h_exp, CharP.cast_eq_zero F p, zero_mul]\n      suffices SL2.E21 F 0 = 1 by rw [this, map_one]\n      ext i j; change !![1, 0; (0 : F), 1] i j = (1 : Matrix (Fin 2) (Fin 2) F) i j; rw [Matrix.one_fin_two]\n    · intro h_eq_one\n      let M : GL (Fin 2) F := Matrix.GeneralLinearGroup.mkOfDetNeZero !![1, 1; 0, 1] (by\n        rw [Matrix.det_fin_two]; exact (by ring : (1 : F) * 1 - 1 * 0 = 1).symm ▸ one_ne_zero)\n      have h_center : Matrix.SpecialLinearGroup.toGL (SL2.E21 F b) ∈ Subgroup.center (GL (Fin 2) F) := by\n        rwa [SL2ToPGL, MonoidHom.comp_apply, ← MonoidHom.mem_ker, QuotientGroup.ker_mk'] at h_eq_one\n      have h_eq : ((Matrix.SpecialLinearGroup.toGL (SL2.E21 F b) * M : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) 0 0 =\n                  ((M * Matrix.SpecialLinearGroup.toGL (SL2.E21 F b) : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) 0 0 := by\n        rw [Subgroup.mem_center_iff.mp h_center M]\n      change (!![1, 0; b, 1] * !![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) F) 0 0 =\n             (!![1, 1; 0, 1] * !![1, 0; b, 1] : Matrix (Fin 2) (Fin 2) F) 0 0 at h_eq\n      simp only [Matrix.mul_apply, Fin.sum_univ_two] at h_eq\n      change (1 : F) * 1 + 0 * 0 = (1 : F) * 1 + 1 * b at h_eq\n      apply hb\n      calc b = ((1 : F) * 1 + 1 * b) - 1 * 1 := by ring\n           _ = ((1 : F) * 1 + 0 * 0) - 1 * 1 := by rw [← h_eq]\n           _ = 0                             := by ring",
  "message": null,
  "goalIsProp": true,
  "filepath": "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/PSLBasic.lean"},
 {"tacticSucceeded": false,
