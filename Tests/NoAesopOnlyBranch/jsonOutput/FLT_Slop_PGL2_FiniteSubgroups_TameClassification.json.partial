  "shortenedStepsCount": 0,
  "parentName": "Dickson.commute_of_fixedPair",
  "oldText":
  "have extract_eigen : ∀ {M : GL (Fin 2) (K p)} {u : Fin 2 → K p} {hu : u ≠ 0},\n      (QuotientGroup.mk M : PGLOf (K p)) • Projectivization.mk (K p) u hu = Projectivization.mk (K p) u\n          hu →\n      ∃ c : K p, M.val.mulVec u = c • u := by\n    intro M u hu h_fix\n    change Projectivization.mk (K p) (M • u) _ = _ at h_fix\n    rw [Projectivization.mk_eq_mk_iff] at h_fix\n    obtain ⟨c, hc⟩ := h_fix\n    exact ⟨(c : K p), hc.symm⟩",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
