  "parentName": "Dickson.fixedPoints_determined",
  "oldText": "rw [hS]",
  "message":
  "Try this:\n\n  [apply]     simp_all only [gt_iff_lt, Nat.card_eq_fintype_card, ne_eq, Set.mem_singleton_iff, not_false_eq_true,\n      Set.finite_singleton, Set.ncard_insert_of_notMem, Set.ncard_singleton, Nat.reduceAdd, Set.mem_insert_iff]\n    cases hx_in with\n    | inl h =>\n      cases hy_in with\n      | inl h_1 =>\n        subst h h_1\n        simp_all only [not_true_eq_false]\n      | inr h_2 =>\n        subst h h_2\n        simp_all only [not_false_eq_true]\n    | inr h_1 =>\n      cases hy_in with\n      | inl h =>\n        subst h_1 h\n        ext x_1 : 1\n        simp_all only [Set.mem_insert_iff, Set.mem_singleton_iff]\n        apply Iff.intro\n        · intro a\n          cases a with\n          | inl h =>\n            subst h\n            simp_all only [or_true]\n          | inr h_1 =>\n            subst h_1\n            simp_all only [or_false]\n        · intro a\n          cases a with\n          | inl h =>\n            subst h\n            simp_all only [or_true]\n          | inr h_1 =>\n            subst h_1\n            simp_all only [or_false]\n      | inr h_2 =>\n        subst h_1 h_2\n        simp_all only [not_true_eq_false]",
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
