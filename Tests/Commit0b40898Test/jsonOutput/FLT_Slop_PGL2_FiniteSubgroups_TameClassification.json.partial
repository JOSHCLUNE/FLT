  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
 {"tacticSucceeded": false,
  "startLine": 686,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orbitPartitionConstruction",
  "oldText":
  "have h_refl : ∀ A : StabType, R A A := fun A ↦ ⟨1, by\n    have h_id : (MulAut.conj (1 : G)).toMonoidHom = MonoidHom.id G := by\n      ext x; have hx : (((MulAut.conj (1 : G)).toMonoidHom) x : G) = 1 * x * 1⁻¹ := rfl\n      rw [hx, inv_one, one_mul, mul_one]; rfl\n    rw [h_id, Subgroup.map_id]⟩",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
 {"tacticSucceeded": false,
  "startLine": 687,
  "startCol": 4,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orbitPartitionConstruction",
  "oldText":
  "have h_id : (MulAut.conj (1 : G)).toMonoidHom = MonoidHom.id G := by\n      ext x; have hx : (((MulAut.conj (1 : G)).toMonoidHom) x : G) = 1 * x * 1⁻¹ := rfl\n      rw [hx, inv_one, one_mul, mul_one]; rfl",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
 {"tacticSucceeded": false,
  "startLine": 692,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.orbitPartitionConstruction",
  "oldText":
  "have h_symm : ∀ {A B : StabType}, R A B → R B A := fun {A B} ⟨g, hg⟩ ↦ ⟨g⁻¹, by\n    rw [hg, Subgroup.map_map]\n\n    have h_comp_id : (MulAut.conj g⁻¹).toMonoidHom.comp (MulAut.conj g).toMonoidHom = MonoidHom.id\n        G := by\n      ext x; have hx : (((MulAut.conj g⁻¹).toMonoidHom.comp (MulAut.conj g).toMonoidHom) x : G) =\n          g⁻¹ * (g * x * g⁻¹) * g⁻¹⁻¹ := rfl\n      rw [hx, inv_inv, ← mul_assoc g⁻¹ (g * x) g⁻¹, ← mul_assoc g⁻¹ g x, inv_mul_cancel, one_mul,\n          mul_assoc, inv_mul_cancel, mul_one]; rfl\n    rw [h_comp_id, Subgroup.map_id]⟩",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
