  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.disjoint_fixedPairs",
  "oldText":
  "have h_eq : ∀ {u v : ProjectiveLine p}, u ≠ v → u ∈ S → v ∈ S → S = {u, v} := by\n    intro u v huv hu hv\n    obtain ⟨a, b, _, hS⟩ : ∃ a b, a ≠ b ∧ S = {a, b} := Set.ncard_eq_two.mp h2\n    rw [hS] at hu hv ⊢\n    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hu hv\n    rcases hu with rfl | rfl\n\n    · rcases hv with rfl | rfl\n      · exact absurd rfl huv\n\n      · rfl\n\n    · rcases hv with rfl | rfl\n      · ext z\n        rw [Set.mem_insert_iff, Set.mem_singleton_iff]\n        exact ⟨Or.symm, Or.symm⟩\n\n      · exact absurd rfl huv",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
