  "shortenedStepsCount": 0,
  "parentName": "Dickson.orbitPartitionConstruction",
  "oldText":
  "let R (A B : StabType) : Prop := ∃ g : G, B.val = A.val.map (MulAut.conj g).toMonoidHom",
  "message": null,
