  "parentName": "Dickson.orbitPartitionConstruction",
  "oldText":
  "let StabType := {H : Subgroup G // ∃ x y : ProjectiveLine p,\n      x ≠ y ∧ H = pairStabilizer p G x y ∧ Nontrivial H}",
