  "shortenedStepsCount": 0,
  "parentName": "Dickson.exists_unique_normalizedLift",
  "oldText":
  "let g' : GL (Fin 2) (K p) :=\n    { val := d⁻¹ • g₀.val\n      inv := d • g₀.inv\n      val_inv := by\n        rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul, inv_mul_cancel₀ hd_ne_zero, one_smul,\n            g₀.val_inv]\n      inv_val := by\n        rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul, mul_inv_cancel₀ hd_ne_zero, one_smul,\n            g₀.inv_val] }",
  "message": null,
  "goalIsProp": true,
  "filepath":
