  "oldText":
  "have h_inj : Function.Injective f := fun x y hxy ↦\n    mul_inv_eq_one.mp <| Subgroup.mem_bot.mp <| h_kernel_trivial ▸\n      MonoidHom.mem_ker.mpr (by rw [map_mul, map_inv, hxy, mul_inv_cancel])",
