  "parentName": "Dickson.sylow_comm_exp_p",
  "oldText":
  "haveI : Finite H := Finite.of_surjective\n    (fun g : P.toSubgroup ↦ (⟨g.1.1, Subgroup.mem_map_of_mem G.subtype g.2⟩ : H))\n    (fun ⟨y, hy⟩ ↦ by\n      obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.mp hy\n      exact ⟨⟨x, hx⟩, rfl⟩)",
