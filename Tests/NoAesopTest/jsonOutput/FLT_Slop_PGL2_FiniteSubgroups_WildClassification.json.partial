  "oldText":
  "have h_subgroup_eq : ∀ {H K : Subgroup G}, H ≤ K → Nat.card H = Nat.card K → H = K := fun hHK hcard ↦ SetLike.ext' (Set.eq_of_subset_of_ncard_le hHK hcard.ge)",
