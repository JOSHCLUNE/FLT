 {"tacticSucceeded": false,
  "startLine": 391,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.pairStabilizer_isCyclic",
  "oldText":
  "have hom_inj : Function.Injective hom := by\n    intro g₁ g₂ h_eq\n    apply mul_inv_eq_one.mp\n    apply Subtype.ext; apply Subtype.ext\n\n    have h_div : c (g₁ * g₂⁻¹) = 1 := by\n      rw [hc_mul, show c g₁ = c g₂ from h_eq, ← hc_mul, mul_inv_cancel, h_c_one]\n    exact (hf_mk (g₁ * g₂⁻¹)).symm.trans <|\n      scalar_eq_one_in_PGL p (f (g₁ * g₂⁻¹)) 1 x y hxy\n        (by rw [hc_x, h_div, one_smul]) (by rw [hf_y, one_smul])",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
