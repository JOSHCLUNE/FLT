 {"tacticSucceeded": false,
  "startLine": 355,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.pairStabilizer_isCyclic",
  "oldText":
  "have hf_mul : ∀ g₁ g₂ : pairStabilizer p G x y, f (g₁ * g₂) = f g₁ * f g₂ := by\n    intro g₁ g₂\n    symm\n    apply hf_uniq (g₁ * g₂)\n\n    · change (QuotientGroup.mk (f g₁) : PGLOf (K p)) * (QuotientGroup.mk (f g₂) : PGLOf (K p)) = (g₁ : PGLOf (K p)) *\n        (g₂ : PGLOf (K p))\n      rw [hf_mk, hf_mk]\n\n    · rw [Units.val_mul, ← Matrix.mulVec_mulVec, hf_y, hf_y]",
