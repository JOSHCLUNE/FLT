 {"tacticSucceeded": false,
  "startLine": 254,
  "startCol": 2,
  "shortenedStepsCount": 0,
  "parentName": "Dickson.exists_unique_normalizedLift",
  "oldText":
  "obtain ⟨d, hd_ne_zero, hd⟩ : ∃ d : K p, d ≠ 0 ∧ g₀.val.mulVec y.rep = d • y.rep := by\n    have h_fix : (QuotientGroup.mk g₀ : PGLOf (K p)) • Projectivization.mk (K p) y.rep y.rep_nonzero =\n        Projectivization.mk (K p) y.rep y.rep_nonzero := by\n      rw [Projectivization.mk_rep y, hg₀, hgy]\n    change Projectivization.mk (K p)\n        (g₀.val.mulVec y.rep) _ = Projectivization.mk (K p) y.rep y.rep_nonzero at h_fix\n    rw [Projectivization.mk_eq_mk_iff] at h_fix\n    obtain ⟨c, hc⟩ := h_fix\n    exact ⟨(c : K p), c.ne_zero, hc.symm⟩",
  "message": null,
  "goalIsProp": true,
  "filepath":
  "/data/FLT/FLT/Slop/PGL2/FiniteSubgroups/TameClassification.lean"},
