  "parentName": "Dickson.three_transitive_case4",
  "oldText":
  "have h_det : α * (β - γ) * (γ - α) - β * (γ - α) * (β - γ) ≠ 0 := by\n    intro heq; have h1 : α * (β - γ) * (γ - α) - β * (γ - α) * (β - γ) = (α - β) * (β - γ) * (γ - α) := by ring\n    exact mul_ne_zero (mul_ne_zero (sub_ne_zero.mpr hαβ) (sub_ne_zero.mpr hβγ)) (sub_ne_zero.mpr hαγ.symm) (by rw [h1] at heq; exact heq)",
  "message": null,
